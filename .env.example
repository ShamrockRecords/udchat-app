NODE_ENV=development
PORT=3000
ROOT_URL=http://localhost:3000
# Use a stable random secret of at least 32 bytes. Required in production.
SESSION_SECRET=

# Server-side Firebase Authentication API key (not a browser referrer-restricted key).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Service account. Literal \n and actual newlines are both supported in the private key.
FIREBASE_ADMINSDK_project_id=
FIREBASE_ADMINSDK_client_email=
FIREBASE_ADMINSDK_private_key=

# Optional browser API keys. Restrict these to your application's HTTP referrers.
OPENED_FIREBASE_API_KEY=
GOOGLE_CLOUD_TRANSLATION_API_KEY=
