<!doctype html>
<html lang="<%= lang %>">
	<head>
		<title><%- __("APP_NAME") %> - <%= title %></title>
		<%- include('parts/head', {}) %>
		<script src="/socket.io/socket.io.js"></script>


        <link rel="stylesheet" href="/stylesheets/chat.css">
		<script src="../javascripts/language_support.js"></script>
        <script src="/javascripts/speech_recognition.js"></script>
	</head>
	<body class="chat-page">
		<script>
			// Keep the shareable room URL after a successful passcode form submission.
            if (location.pathname === '/chat/passcode') {
                history.replaceState(null, '', '/chat?chatId=' + encodeURIComponent(<%- jsonForScript(requestId) %>));
            }
            let socket = io({ autoConnect: false, auth: { token: <%- jsonForScript(chatToken) %> } });
            socket.on('connect_error', error => {
                document.getElementById('chat-error').textContent = error.message;
                setConnectionState(false);
            });
            socket.on('chatError', error => {
                document.getElementById('chat-error').textContent = error.message;
            });
            socket.on('disconnect', reason => {
                setConnectionState(false);
                document.getElementById('chat-error').textContent = reason === 'io server disconnect'
                    ? 'Please reopen the chat.' : 'Reconnecting…';
            });
			let isBottom = true ;
			let becameBackground = false ;
			let uidMap = Object.create(null);
			let uidArray = [] ;

			// When message came.
			socket.on('message', async (message) => {
				let commands = JSON.parse(message) ;
				let readerTargetElement = null ;

				for (let key in commands) {
					let command = commands[key] ;
					let timestamp = command.timestamp ;

					if (command.method == 'requestConnecting') {
						let commands = [] ;

						{
							let command = {
								requestId: <%- jsonForScript(requestId) %>,
								uid: <%- jsonForScript(uid) %>,
								name: <%- jsonForScript(name) %>,
								language: $('#inputLanguages option:selected').val(),
								message: <%- jsonForScript(name) %> + '<%- __("が参加しました。") %>',
								method: 'information',
							} ;

							commands.push(command) ;
							commands.push(createStatusCommand('joined')) ;
							commands.push(createStatusCommand('focused')) ;
						}

						sendCommands(socket, commands) ;
					
						continue ;
					}

					// escape
					command.name = escapeHTML(command.name) ;
					command.message = escapeHTML(command.message) ;

					if (command.translation != undefined) {
						command.translation = escapeHTML(command.translation) ;
					}

					if (command.reverseTranslation != undefined) {
						command.reverseTranslation = escapeHTML(command.reverseTranslation) ;
					}

					command.message = command.message.replace(/\n/g, "<br />") ;
					command.message = command.message.replace(/((http|https|ftp):\/\/[\w?=&.\/-;#~%-]+(?![\w\s?&.\/;#~%"=-]*>))/g, '<a href="$1" target="_blank" rel="noopener noreferrer">$1</a> ')

					let element = $('<div class="message-group">') ;
					
					if (command.method == 'message' || command.method == 'information') {
						if (<%- jsonForScript(uid) %> == command.uid) {
							element.append($('<div class="right message-meta">').html(getDateString(timestamp))) ;

							if (command.method == 'information') {
								readerTargetElement = $('<div class="right px-4 py-2 small">') ;
								element.append(readerTargetElement.html(command.message)) ;
							} else {
								readerTargetElement = $('<div class="right message-bubble messageRight">') ;
								element.append(readerTargetElement.html(command.message)) ;
							
								if ((command.translation != undefined && command.translation != '') && 
									(command.reverseTranslation != undefined && command.reverseTranslation != '')) {
									element.append($('<div class="right message-bubble messageRight reversetTranslation">').html('<span style="font-size: small;">' + command.translation + '</span>' + '<br />' + command.reverseTranslation)) ;
								}
							}
						} else {
							element.append($('<div class="left message-meta">').html('<span class="sender-name">' + command.name + '</span>' + getDateString(timestamp))) ;

							if (command.method == 'information') {
								readerTargetElement = $('<div class="left small">') ;
								element.append(readerTargetElement.html(command.message)) ;
							} else {
								readerTargetElement = $('<div class="left message-bubble messageLeft">') ;
								element.append(readerTargetElement.html(command.message)) ;
							}

							let translation = "" ;
							
							if (command.language != undefined && command.needsTranslating) {
								await translate(<%- jsonForScript(apiKey) %>, command.message, command.language, $('#languages option:selected').val(), (t, from) => {
									translation = t ;
									if (from != undefined) {
										command.language = from ;
									}
								}) ;
							}

							if (translation != "" && command.language != $('#languages option:selected').val()) {
								readerTargetElement = $('<div class="left message-bubble messageLeft translation">') ;
								element.append(readerTargetElement.text($('<textarea>').html(translation).text())) ;
							}
						}

						if (command.method === 'information') {
                            element.addClass('message-info').empty();
                            readerTargetElement = $('<span>').html(command.message);
                            element.append(readerTargetElement);
                        }
                        $('#messages').append(element);
					} else if (command.method == 'status') {
						updateMemberList(command) ;
					}
				}

				if (readerTargetElement != null) {
					readerTargetElement.attr('aria-live', 'polite');
				}

				// If commands were included not "status", do automatic scroll or show notification.
				for (let key in commands) {
					let commnad = commands[key] ;

					if (commnad.method != 'status') {
						if (isBottom || <%- jsonForScript(uid) %> == commnad.uid) {
							scrollToEnd() ;

							if (becameBackground) {
								sendNewMessageNotification(commnad.message) ;
							}
						} else {
							sendNewMessageNotification(commnad.message) ;

							$('#notification').prop('hidden', false) ;
							$('#notification').show() ;
						}

						break ;
					}
				}
			});

			function scrollToEnd() {
				$('#messages').animate({scrollTop: $('#messages').get(0).scrollHeight},'fast');
				$('#notification').hide() ;
			}

            function sendNewMessageNotification(message) {
                if ('Notification' in window && Notification.permission === 'granted') {
                    try {
                        const notification = new Notification(<%- jsonForScript(__('APP_NAME') + ' - ' + title) %>, { body: message });
                        notification.onclick = () => { scrollToEnd(); window.focus(); notification.close(); };
                        setTimeout(() => notification.close(), 10000);
                    } catch {}
                }
            }

			function updateMemberList(command) {
				if (command.param == 'joined') {
					if (uidMap[command.uid] == undefined) {
						uidMap[command.uid] = command ;
						uidArray.unshift(command.uid) ;
					} else {
						let index = uidArray.indexOf(command.uid) ;

						if (index > 0) {
							uidArray.splice(index, 1) ;
							uidArray.unshift(command.uid) ;
						}
					}
				} else if (command.param == 'left') {
					if (uidMap[command.uid] != undefined) {
						delete uidMap[command.uid] ;

						let index = uidArray.indexOf(command.uid) ;

						if (index >= 0) {
							uidArray.splice(index, 1) ;
						}
					}
				} else if (command.param == 'focused') {
					if (uidMap[command.uid] == undefined) {
						uidMap[command.uid] = command ;
						uidArray.unshift(command.uid) ;
					} else {
						uidMap[command.uid] = command ;
					}
				} else if (command.param == 'unfocused') {
					if (uidMap[command.uid] == undefined) {
						uidMap[command.uid] = command ;
						uidArray.unshift(command.uid) ;
					} else {
						uidMap[command.uid] = command ;
					}
				} else {
					return ;
				}

				$('#members').empty() ;
				
				let count = 0 ;

				for (let key in uidArray) {
					let command = uidMap[uidArray[key]] ;

					if (command.param == 'focused') {
						$('#members').append($('<div class="member is-focused">').attr('id', command.uid).text($('<textarea>').html(command.name).text()));
					} else {
						$('#members').append($('<div class="member">').attr('id', command.uid).text($('<textarea>').html(command.name).text()));
					}

					count++ ;

					if (count == 10) {
						break ;
					}
				}

				if (uidArray.length != count) {
					$('#members').append($('<div class="p-1 small">').text('<%- __("他") %>' + (uidArray.length - count) + '<%- __("人参加しています") %>')) ;
				}
				
				$('#memberCount').text(uidArray.length);
                if (Object.keys(uidMap).length == 0) {
					$('#membersPanel').prop('hidden', true) ;
				}
			}

			//
            function sendCommands(socket, commands) {
                if (socket.connected) socket.send(JSON.stringify(commands));
            }

			//
			function createStatusCommand(status) {
				return {
					requestId: <%- jsonForScript(requestId) %>,
					uid: <%- jsonForScript(uid) %>,
					name: $('#displayName').val(),
					language: '',
					message: '',
					method: 'status',
					param: status
				} ;
			}

			// Window loaded.
			$(window).on('load', async function() {				
				if ('Notification' in window && Notification.permission === 'default') {
                    document.addEventListener('click', () => Notification.requestPermission().catch(() => {}), { once: true });
                }

				$('#messages').scroll(() => {
					let clientHeight = $('#messages').get(0).clientHeight ;
					let scrollHeight = $('#messages').get(0).scrollHeight ;

					if (scrollHeight - (clientHeight + $('#messages').scrollTop()) <= 4) {
    					isBottom = true ;
						$('#notification').hide() ;
  					} else {
						isBottom = false ;
					}
				}) ;

				$('#notification').hide() ;

				let languages = await supportedLanguages(<%- jsonForScript(apiKey) %>) ;
				let locales = getSupportedSpeechRecognitionLocales() ;

				initLauguageSelect('languages', getDefaultLanguage(), '<%- __("なし") %>', languages) ;
				initLauguageSelect('inputLanguages', '', '<%- __("自動判別") %>', languages) ;
				initLauguageSelect('reverseTranslationLanguages', '', '<%- __("なし") %>', languages) ;
				initLauguageSelect('speechRecognitionLocales', '', '<%- __("ブラウザ設定") %>', locales) ;
				
                socket.on('connect', () => {
                    document.getElementById('chat-error').textContent = '';
                    setConnectionState(true);
                    $('#messages').empty();
                    uidMap = Object.create(null);
                    uidArray = [];
                    $('#members').empty();
                    sendCommands(socket, [{ requestId: <%- jsonForScript(requestId) %>, method: 'requestConnecting' }]);
                });
                socket.connect();

				initSpeechRecognition();
                $('#displayName').on('input', function() { $('#currentDisplayName').text(this.value); });

				// resetTranslationSettingsButton was clicked.
				$('#resetTranslationSettingsButton').on('click', () => {
					$('#languages').val(getDefaultLanguage()) ;
					$('#inputLanguages').val('') ;
					$('#reverseTranslationLanguages').val('') ;
					$('#speechRecognitionLocales').val('') ;

					localStorage.setItem('languages', $('#languages' + ' option:selected').val());
					localStorage.setItem('inputLanguages', $('#inputLanguages' + ' option:selected').val());
					localStorage.setItem('reverseTranslationLanguages', $('#reverseTranslationLanguages' + ' option:selected').val());
					localStorage.setItem('speechRecognitionLocales', $('#speechRecognitionLocales' + ' option:selected').val());
				}) ;

				// notification label was clicked.
				$('#notification').on('click', () => {
					$('#messages').animate({scrollTop: $('#messages').get(0).scrollHeight},'fast');
					$('#notification').hide() ;
				}) ;

				// sendButton was clicked.
				$('#sendButton').on('click', () => {
					if (!socket.connected) return;
                    let text = $('#message').val() ;

					$('#message').val('') ;

					send(text) ;
				}) ;

				// showMembersButton was clicked.
				$('#showMembersButton').on('click', () => {
					if ($('#membersPanel').prop('hidden')) {
						$('#membersPanel').prop('hidden', false) ;
						
						localStorage.setItem('showMembers', true);
                        $('#showMembersButton').attr('aria-expanded', 'true');
					} else {
						$('#membersPanel').prop('hidden', true) ;

						localStorage.setItem('showMembers', false);
                        $('#showMembersButton').attr('aria-expanded', 'false');
					}
				}) ;

				if (localStorage.getItem('showMembers') === 'true') {
                    $('#showMembersButton').attr('aria-expanded', 'true');
					$('#membersPanel').prop('hidden', false) ;
				}
				
				// When user actived.
				$(window).on('focus', () => {
					becameBackground = false ;
					sendCommands(socket, [createStatusCommand('focused')]) ;
				}) ;

				// When user unactived.
				$(window).on('blur', () => {
					becameBackground = true ;
					sendCommands(socket, [createStatusCommand('unfocused')]) ;
				}) ;
			}) ;

			// keypress detected.
			$(document).on('keydown', '#message', function(e) {
				if (e.key === 'Enter' && !e.shiftKey && !e.originalEvent?.isComposing && e.keyCode !== 229) {
					if (!socket.connected) return;
                    let text = $('#message').val() ;

					$('#message').val('') ;

					send(text) ;
					e.preventDefault();
				}
			}) ;
		
            function setConnectionState(connected) {
                $('#connectionStatus').toggleClass('is-connected', connected);
                $('#connectionLabel').text(connected ? <%- jsonForScript(__('接続中')) %> : <%- jsonForScript(__('接続待機中')) %>);
                $('#sendButton').prop('disabled', !connected);
            }

			// send message
			async function send(text) {
				if (text != '') {
					let selectedInputLanguage = $('#inputLanguages option:selected').val() ;

					if (selectedInputLanguage == '') {
						await detect(<%- jsonForScript(apiKey) %>, text, (language) => {
							selectedInputLanguage = language ;
						}) ;
					}

					let selectedReverseTranslationLanguage = $('#reverseTranslationLanguages option:selected').val() ;
					let translation = '' ;
					let reverseTranslation = '' ;

					if (selectedReverseTranslationLanguage != '' &&
						selectedInputLanguage != selectedReverseTranslationLanguage) {
				
						await translate(<%- jsonForScript(apiKey) %>, text, selectedInputLanguage, selectedReverseTranslationLanguage, (t, from) => {
							translation = unescapeHTML(t) ;
						}) ;

						await translate(<%- jsonForScript(apiKey) %>, translation, selectedReverseTranslationLanguage, selectedInputLanguage, (t, from) => {
							reverseTranslation = unescapeHTML(t) ;
						}) ;
					}

					let command = {
						requestId: <%- jsonForScript(requestId) %>,
						uid: <%- jsonForScript(uid) %>,
						name: $('#displayName').val(),
						language: selectedInputLanguage,
						message: text,
						method:'message',
						translation: translation,
						translationLanguage: selectedReverseTranslationLanguage,
						reverseTranslation: reverseTranslation,
					} ;

					sendCommands(socket, [command, createStatusCommand('focused')]) ;
				}
			}

			function initLauguageSelect(tag, defaultLanguage, defaultOption, languages) {					
				if (localStorage.getItem(tag) != undefined) {
					defaultLanguage = localStorage.getItem(tag) ;
				}

				if (defaultOption != '') {
					let option = $('<option>') ;

					option.attr("value", '') ;
					option.text(defaultOption) ;

					if (defaultLanguage == "") {
						option.prop('selected', true) ;
					}

					$('#' + tag).append(option) ;
				}

				for (let key in languages) {
					let option = $('<option>') ;

					option.attr("value", languages[key].language) ;

					if (defaultLanguage != "" && defaultLanguage == languages[key].language) {
						option.prop('selected', true) ;
					}

					option.text(languages[key].name) ;

					$('#' +tag).append(option) ;
				}

				$('#' +tag).change(() => {
					localStorage.setItem(tag, $('#' +tag + ' option:selected').val());
				}) ;
			}

            function initSpeechRecognition() {
                try {
                    const button = $('#speechRecongizerButton');
                    const controller = createContinuousSpeechRecognition({
                        SpeechRecognition: window.SpeechRecognition || window.webkitSpeechRecognition,
                        getLanguage: () => $('#speechRecognitionLocales option:selected').val() || navigator.language,
                        onTranscript: text => send(text),
                        onStateChange: enabled => {
                            button.find('.speech-label').text(enabled ? <%- jsonForScript(__('停止')) %> : <%- jsonForScript(__('音声入力')) %>);
                            button.attr('aria-pressed', String(enabled));
                            button.toggleClass('is-listening', enabled);
                            $('#speechStatus').prop('hidden', !enabled);
                        },
                        onError: error => console.error('Speech recognition failed:', error.error || error.name),
                    });
                    button.on('click', controller.toggle);
                    window.addEventListener('pagehide', controller.stop);
                    $('#speechRecongizerButtonCol').prop('hidden', false);
                } catch (error) {
                    $('#speechRecongizerButtonCol').prop('hidden', true);
                    $('#speechRecognitionLocales').prop('disabled', true);
                }
            }

		</script>

        <div class="chat-layout">
            <nav class="chat-rail" aria-label="<%= __('トップページ') %>">
                <a class="brand" href="/" title="UD Chat"><%- include('parts/brand') %></a>
                <a class="rail-link" href="/" title="<%= __('トップページ') %>" aria-label="<%= __('トップページ') %>"><i class="far fa-comments" aria-hidden="true"></i></a>
                <% if (isAlreadySignIn) { %><a class="rail-link" href="/profile" title="<%= __('プロフィール') %>" aria-label="<%= __('プロフィール') %>"><i class="far fa-user" aria-hidden="true"></i></a><% } %>
                <a class="rail-link" href="/about" title="<%= __('ご利用について') %>" aria-label="<%= __('ご利用について') %>"><i class="far fa-question-circle" aria-hidden="true"></i></a>
            </nav>
            <main id="main" class="chat-main">
                <header class="chat-header">
                    <div class="chat-heading">
                        <span class="room-symbol" aria-hidden="true"><i class="far fa-comments"></i></span>
                        <div>
                            <p class="eyebrow">CHAT ROOM</p>
                            <h1 title="<%= title %>"><%= title %></h1>
                            <div class="connection-status" id="connectionStatus" role="status"><span class="connection-dot" aria-hidden="true"></span><span id="connectionLabel"><%= __('接続待機中') %></span></div>
                        </div>
                    </div>
                    <div class="chat-tools">
                        <button class="btn btn-light icon-button" id="showMembersButton" type="button" aria-label="<%= __('参加者リスト') %>" title="<%= __('参加者リスト') %>" aria-controls="membersPanel" aria-expanded="false"><i class="far fa-user" aria-hidden="true"></i><span class="tool-label"><%= __('参加者') %></span><span id="memberCount">0</span></button>
                        <button class="btn btn-light icon-button" type="button" data-toggle="modal" data-target="#shareModal" aria-label="<%= __('バーコード') %>" title="<%= __('バーコード') %>"><i class="fas fa-qrcode" aria-hidden="true"></i><span class="tool-label"><%= __('共有') %></span></button>
                        <button class="btn btn-light icon-button" id="settingButton" type="button" data-toggle="modal" data-target="#settingsModal" aria-label="<%= __('設定を開く') %>" title="<%= __('設定を開く') %>"><i class="fas fa-sliders-h" aria-hidden="true"></i><span class="tool-label"><%= __('設定') %></span></button>
                    </div>
                </header>
                <div id="chat-error" role="alert"></div>
                <div class="conversation">
                    <div id="messages" aria-label="<%= __('メッセージ') %>" tabindex="0"></div>
                    <button class="btn btn-primary btn-sm" id="notification" type="button" hidden><i class="fas fa-arrow-down" aria-hidden="true"></i><%= __('新しいメッセージがあります') %></button>
                    <section class="members-panel" id="membersPanel" hidden aria-label="<%= __('参加者リスト') %>"><h2><%= __('参加者リスト') %></h2><div id="members"></div></section>
                </div>
                <div class="composer-area" id="operation">
                    <div class="composer">
                        <textarea class="form-control" id="message" name="message" rows="2" aria-label="<%= __('メッセージを入力') %>" placeholder="<%= __('メッセージを入力') %>" maxlength="200" aria-describedby="hint"></textarea>
                        <div class="composer-actions">
                            <div id="speechRecongizerButtonCol" hidden><button class="btn icon-button" id="speechRecongizerButton" type="button" aria-pressed="false"><i class="fas fa-microphone" aria-hidden="true"></i><span class="speech-label"><%= __('音声入力') %></span></button></div>
                            <span class="speech-status" id="speechStatus" role="status" hidden><%= __('話し終わるたびに自動送信') %></span>
                            <span class="composer-hint" id="hint"><%= __('入力操作のヒント') %></span>
                            <button class="btn btn-primary icon-button" id="sendButton" type="button" disabled><%= __('送信') %><i class="fas fa-arrow-up" aria-hidden="true"></i></button>
                        </div>
                    </div>
                    <div class="composer-caption"><span><i class="far fa-user" aria-hidden="true"></i> <span id="currentDisplayName"><%= name %></span></span><a href="<%= isAlreadySignIn ? '/' : '/signin?chatId=' + encodeURIComponent(requestId) %>"><%= __(isAlreadySignIn ? 'APP_NAME_OPEN' : 'APP_NAME_SIGN_IN') %> <span aria-hidden="true">↗</span></a></div>
                </div>
            </main>
        </div>
        <div class="modal fade" id="shareModal" role="dialog" tabindex="-1" aria-labelledby="shareTitle" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
                <div class="modal-header"><h2 class="modal-title" id="shareTitle"><%= __('チャットを共有') %></h2><button type="button" class="close" data-dismiss="modal" aria-label="<%= __('閉じる') %>"><span aria-hidden="true">×</span></button></div>
                <div class="modal-body text-center"><h3><%= title %></h3><img class="qr-image" src="<%= qrCode %>" alt="<%= title %> QR code" width="300" height="300"><p class="text-muted small"><%= __('QRコードを読み取って参加できます。') %></p></div>
                <div class="modal-footer"><button type="button" class="btn btn-light" data-dismiss="modal"><%= __('閉じる') %></button></div>
            </div></div>
        </div>
        <div class="modal fade" id="settingsModal" role="dialog" tabindex="-1" aria-labelledby="settingsTitle" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
                <div class="modal-header"><h2 class="modal-title" id="settingsTitle"><%= __('チャット設定') %></h2><button type="button" class="close" data-dismiss="modal" aria-label="<%= __('閉じる') %>"><span aria-hidden="true">×</span></button></div>
                <div class="modal-body"><div class="settings-grid">
                    <div class="form-group"><label for="displayName"><%= __('名前') %></label><input class="form-control" id="displayName" name="displayName" value="<%= name %>" maxlength="30"></div>
                    <% if (apiKey != '') { %>
                        <div class="form-group"><label for="languages"><%= __('翻訳言語') %></label><select class="form-control" id="languages" title="<%= __('翻訳して表示する言語を選択します。') %>"></select></div>
                        <div class="form-group"><label for="inputLanguages"><%= __('入力言語') %></label><select class="form-control" id="inputLanguages" title="<%= __('自分が入力する言語を選択します。') %>"></select></div>
                        <div class="form-group"><label for="reverseTranslationLanguages"><%= __('再翻訳言語') %></label><select class="form-control" id="reverseTranslationLanguages" title="<%= __('再翻訳して翻訳結果を確認する言語を選択します。') %>"></select></div>
                    <% } %>
                    <div class="form-group"><label for="speechRecognitionLocales"><%= __('音声入力言語') %></label><select class="form-control" id="speechRecognitionLocales" title="<%= __('音声入力をする言語を選択します。') %>"></select></div>
                </div><button class="btn btn-light btn-sm" type="button" id="resetTranslationSettingsButton"><i class="fas fa-undo" aria-hidden="true"></i><%= __('言語設定をリセット') %></button></div>
                <div class="modal-footer"><button type="button" class="btn btn-primary" data-dismiss="modal"><%= __('閉じる') %></button></div>
            </div></div>
        </div>
    </body>
</html>
