<!doctype html>
<html lang="<%= lang %>">
<head><title>UD Chat — <%= __('パスワードリセット') %></title><%- include('parts/head') %><link href="/stylesheets/signin.css" rel="stylesheet"></head>
<body class="auth-page">
    <header class="auth-header"><a class="brand" href="/"><%- include('parts/brand') %></a><%- include('parts/lang') %></header>
    <main class="auth-single"><section class="auth-card">
        <p class="eyebrow">ACCOUNT RECOVERY</p><h2><%= __('パスワードリセット') %></h2>
        <p class="text-muted small"><%= __('入力したメールアドレスに再設定の案内がとどきます') %></p>
        <form class="form-signin" method="post" action="/reset_password">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label for="inputEmail"><%= __('メールアドレス') %></label><input type="email" name="email" id="inputEmail" class="form-control" placeholder="name@example.com" autocomplete="email" required>
            <% if (errorMessage) { %><div class="alert alert-primary my-3" role="alert"><%= errorMessage %></div><% } %>
            <button class="btn btn-primary btn-block" type="submit"><%= __('リセット') %></button>
        </form>
        <div class="auth-links"><a href="/signin"><%= __('サインインに戻る') %></a></div>
    </section></main>
    <%- include('parts/footer') %>
</body></html>
