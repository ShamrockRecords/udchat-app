<!doctype html>
<html lang="<%= lang %>">
<head><title>UD Chat — <%= __('サインアップ') %></title><%- include('parts/head') %><link href="/stylesheets/signin.css" rel="stylesheet"></head>
<body class="auth-page">
    <header class="auth-header"><a class="brand" href="/"><%- include('parts/brand') %></a><%- include('parts/lang') %></header>
    <main class="auth-layout">
        <%- include('parts/auth_story') %>
        <section class="auth-card" aria-labelledby="authTitle">
            <p class="eyebrow">WELCOME TO UD CHAT</p>
            <h2 id="authTitle"><%= __('サインアップ') %></h2>
            <form class="form-signin" method="post" action="/signup">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="chatId" value="<%= chatId %>">
                <div class="form-group"><label for="inputEmail"><%= __('メールアドレス') %></label><input type="email" name="email" id="inputEmail" class="form-control" placeholder="name@example.com" autocomplete="email" required></div>
                <div class="form-group"><label for="inputPassword"><%= __('パスワード') %></label><input type="password" name="password" id="inputPassword" class="form-control" autocomplete="new-password" required></div>
                <% if (errorMessage) { %><div class="alert alert-primary" role="alert"><%= errorMessage %></div><% } %>
                <button class="btn btn-primary btn-block" type="submit"><%= __('サインアップ') %> <span aria-hidden="true">→</span></button>
                <p class="auth-notice"><%= __('サインアップ後に認証メールが届きます') %></p>
            </form>
            <%- include('parts/firebase_login', { config, chatId }) %>
            <div class="auth-links"><a href="/signin<%= chatId ? '?chatId=' + encodeURIComponent(chatId) : '' %>"><%= __('サインインに戻る') %></a></div>
        </section>
    </main>
    <%- include('parts/footer') %><a class="auth-footer-link" href="/about"><%= __('ご利用について') %></a>
</body>
</html>
