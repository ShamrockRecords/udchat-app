<!doctype html>
<html lang="<%= lang %>">
	<head>
		<title><%- __("UD Chat") %> - <%- __("パスコード") %></title>
		<%- include('parts/head', {}) %>
	</head>
	<body>
		<nav class="navbar navbar-expand-md navbar-light app-nav">
			<a class="brand" href="/"><%- include('parts/brand') %></a>
			<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
				<span class="navbar-toggler-icon"></span>
			</button>
			<div class="collapse navbar-collapse" id="navbarNav">
				<ul class="navbar-nav">
					<% if (!isAlreadySignIn) { %>
						<li class="nav-item">	
							<a class="nav-link" href="/signin?chatId=<%= chatId %>"><%- __("サインイン") %></a>
						</li>
					<% } %>
					<li class="nav-item">
						<a class="nav-link" href="/about"><%- __("ご利用について") %></a>
					</li>
				</ul>
			</div>
		</nav>
		
		<main class="form-page join-page"><%- include('parts/lang', {}) %>

		<div class="form-card"><header class="join-heading"><span class="room-symbol" aria-hidden="true"><i class="far fa-comments"></i></span><p class="eyebrow">YOU'RE INVITED</p><h1><%= title %></h1><p><%= __('名前を入力して、会話に参加しましょう。') %></p></header>
			<form method="POST" action="/chat/passcode">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
				<div class="form-group">
					<label for="displayName"><%- __("名前") %></label>
					<input required type="text" maxlength="30" class="form-control" id="displayName" name="displayName" value="<%= displayName %>" aria-describedby="displayNameHelp">
					<small id="displayNameHelp" class="form-text text-muted"><%- __("チャットに表示される名前を入力してください。サインインをするとプロフィールの名前になります。") %></small>
				</div>
				<% if (isNeedPasscode) { %>
				<div class="form-group">
					<label for="passcode"><%- __("パスコード") %></label>
					<input required autocomplete="off" type="text" maxlength="30" class="form-control" id="passcode" name="passcode" value="" aria-describedby="passcodeHelp">
					<small id="passcodeHelp" class="form-text text-muted"><%- __("パスコードを入力してください。") %></small>
				</div>
				<% } %>
				<input type="hidden" name="chatId" value="<%= chatId %>">
				<div class="form-group">
					<button type="submit" class="btn btn-primary btn-block"><%- __("参加") %></button>
				</div>
				<script>
					$(function() {
						$('form').on('submit', function() {
							$(this).find(':submit').attr('disabled', 'disabled') ;
					  	});
					});
				</script>
			</form>
		</div>
        </main>
		<%- include('parts/footer', {}) %>
	</body>
</html>